{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/search.php",
      "destination": "/api/search"
    },
    {
      "source": "/remote_api.php",
      "destination": "/api/remote_api"
    }
  ]
}

